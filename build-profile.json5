{
  "app": {
    // 签名材料**不入库**：由 hvigorfile.ts 在构建时从 signing.<mode>.local.json 或环境变量注入。
    // 没有材料 ⇒ 产出未签名包（可编译、可验证，但不可装机）。
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "compatibleSdkVersion": "5.0.5(17)",
        "compatibleSdkVersionStage": "release",
        "runtimeOS": "HarmonyOS",
        "targetSdkVersion": "6.1.1(24)",
        "buildOption": {
          "nativeLib": {
            "collectAllLibs": true
          },
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      { "name": "debug" },
      { "name": "release" }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": ["default"]
        }
      ]
    }
  ]
}
