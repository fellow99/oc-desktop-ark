index 0000000000..856bfd45e4
--- /dev/null
+++ b/packages/app/src/workspaces/selection/roots.ts
@@ -0,0 +1,277 @@
+/**
+ * 选择工作区目录 —— 三个主目录（沙箱 / 文档 / 下载）的客户端策略（oc-desktop-ark 需求 203）。
+ *
+ * 本文件是 `patches/v2.0.26/0007-workspace-roots-picker.patch` 新增的唯一「逻辑」模块：把
+ * 「三个主目录」的**纯函数**（根围栏、根内相对路径、默认名去重、隐藏项过滤）与壳侧能力
+ * RPC 的**调用封装**放在一起，使对话框组件只负责展示与交互。
+ *
+ * 能力侧由壳专用 opencode 插件 `oc-plugin-workspace-roots` 提供
+ * （`POST /api/rpc/oc-harmony-workspace-roots/<method>`）：
+ *   roots / browse / permissionCheck / permissionRequest / openAppInfo / mkdir
+ * 目录**枚举也走该插件**：根围栏、存在性与 `EACCES` 判定都在服务端完成，渲染层拿结构化结果。
+ *
+ * 自门控：`probeWorkspaceRoots` 在 RPC 不可达（未注册 / 非本壳部署 / 插件未激活）时返回
+ * `undefined`，调用方据此**完整回退上游行为**，不出现半残状态。
+ */
+
+export type RootId = "sandbox" | "documents" | "download"
+
+export type RootInfo = {
+  readonly id: RootId
+  /** 绝对真实路径；不可用时为空串（不用 null，规避 schema 联合类型的取值风险） */
+  readonly path: string
+  readonly available: boolean
+  readonly needsPermission: boolean
+  /** 不可用原因（人类可读） */
+  readonly reason: string
+}
+
+export type RootSet = {
+  /** 沙箱家目录（诊断用；宿主注入） */
+  readonly home: string
+  /** 用户主目录（文档/下载的父目录；诊断用） */
+  readonly userHome: string
+  readonly roots: readonly RootInfo[]
+}
+
+export type BrowseEntry = { readonly name: string; readonly type: "file" | "directory" }
+
+export type BrowseResult = {
+  readonly ok: boolean
+  readonly code: string
+  readonly message: string
+  readonly entries: readonly BrowseEntry[]
+  /** 实际展示的条目数 */
+  readonly count: number
+  /** 截断前的条目总数 */
+  readonly total: number
+  readonly truncated: boolean
+}
+
+export type MkdirResult = {
+  readonly ok: boolean
+  readonly code: string
+  readonly message: string
+  readonly path: string
+}
+
+export type PermissionResult = {
+  readonly ok: boolean
+  readonly code: string
+  readonly granted: boolean
+  readonly bridgeUnavailable: boolean
+  /** 申请未在宿主侧上限内返回（本 runtime 可能不弹窗）；既非「已授予」也非「已拒绝」 */
+  readonly timeout: boolean
+  readonly message: string
+}
+
+/** 壳侧能力 RPC 的 id（与 `plugins/oc-plugin-workspace-roots` 的 `definition.id` 一致） */
+export const ROOTS_RPC_ID = "oc-harmony-workspace-roots"
+
+/** 主目录顺序（与插件返回顺序、UI Tab 顺序一致） */
+export const ROOT_IDS = ["sandbox", "documents", "download"] as const satisfies readonly RootId[]
+
+type RpcSdk = {
+  api: {
+    rpc: {
+      call: (input: { rpcID: string; method: string; input?: unknown }) => Promise<{ output?: unknown }>
+    }
+  }
+}
+
+// ------------------------------------------------------------------ 纯函数（可单测）
+
+// 统一分隔符为 `/` 并去尾部分隔符（仅用于包含性判定；不解析 symlink）
+export function normalizeRootPath(input: string): string {
+  const value = String(input ?? "").replaceAll("\\", "/")
+
+  if (value.length <= 1) return value
+  return value.replace(/\/+$/, "") || "/"
+}
+
+/**
+ * `child` 是否位于 `root` 之内（含 `root` 自身）。
+ * 逐段比较以避免 `/a/bc` 被 `/a/b` 命中；含 `..` 一律判否。
+ */
+export function isWithin(root: string, child: string): boolean {
+  const base = normalizeRootPath(root)
+  const target = normalizeRootPath(child)
+
+  if (!base || !target) return false
+  if (base.split("/").includes("..") || target.split("/").includes("..")) return false
+  if (target === base) return true
+  // 逐段比较：根为 `/` 时 `base + "/"` 是 `//`，必须单独处理（否则任何子路径都判否）
+  const prefix = base.endsWith("/") ? base : base + "/"
+  return target.startsWith(prefix)
+}
+
+/** `target` 相对 `root` 的子路径（`root` 自身返回 ""）；越界或含 `..` 返回 undefined */
+export function relativeFromRoot(root: string, target: string): string | undefined {
+  if (!isWithin(root, target)) return undefined
+  const base = normalizeRootPath(root)
+  const value = normalizeRootPath(target)
+
+  if (value === base) return ""
+  return value.slice(base.length).replace(/^\/+/, "") || ""
+}
+
+/** 在已有同级名称中为 `base` 选一个不冲突的名称：`base` → `base 2` → `base 3` … */
+export function defaultFolderName(existing: readonly string[], base: string): string {
+  const taken = new Set(existing.map((name) => name.trim()))
+
+  if (!taken.has(base)) return base
+  let index = 2
+  while (taken.has(`${base} ${index}`)) index += 1
+  return `${base} ${index}`
+}
+
+/** 过滤隐藏项（以 `.` 开头的最后一段）；三根模式不提供「显示隐藏文件」开关 */
+export function filterHiddenEntries(entries: readonly string[]): readonly string[] {
+  return entries.filter((entry) => {
+    const name = entry.replace(/[/\\]+$/, "").split(/[/\\]+/).at(-1) ?? ""
+    return name.length > 0 && !name.startsWith(".")
+  })
+}
+
+/** 目录项最后一段名称（用于默认名去重的同级集合） */
+export function entryName(entry: string): string {
+  return entry.replace(/[/\\]+$/, "").split(/[/\\]+/).at(-1) ?? ""
+}
+
+// ------------------------------------------------------------------ 能力 RPC 封装
+
+function asRootSet(output: unknown): RootSet | undefined {
+  if (output === null || typeof output !== "object") return undefined
+  const candidate = output as { home?: unknown; userHome?: unknown; roots?: unknown }
+
+  if (!Array.isArray(candidate.roots)) return undefined
+  const roots = candidate.roots.flatMap((entry): RootInfo[] => {
+    if (entry === null || typeof entry !== "object") return []
+    const item = entry as Record<string, unknown>
+
+    if (typeof item.id !== "string" || !ROOT_IDS.includes(item.id as RootId)) return []
+    return [
+      {
+        id: item.id as RootId,
+        path: typeof item.path === "string" ? item.path : "",
+        available: item.available === true,
+        needsPermission: item.needsPermission === true,
+        reason: typeof item.reason === "string" ? item.reason : "",
+      },
+    ]
+  })
+
+  if (roots.length === 0) return undefined
+  return {
+    home: typeof candidate.home === "string" ? candidate.home : "",
+    userHome: typeof candidate.userHome === "string" ? candidate.userHome : "",
+    roots,
+  }
+}
+
+/**
+ * 探测主目录能力。RPC 不可达或返回形状不符时返回 `undefined`（调用方回退上游行为）。
+ * 不抛错：能力缺失是「非本壳部署」的正常形态，不是错误。
+ */
+export async function probeWorkspaceRoots(sdk: RpcSdk): Promise<RootSet | undefined> {
+  try {
+    return asRootSet((await sdk.api.rpc.call({ rpcID: ROOTS_RPC_ID, method: "roots", input: {} })).output)
+  } catch {
+    return undefined
+  }
+}
+
+/** 列某个主目录（`sub` 为根内相对子路径，"" = 根）。失败返回带 `code` 的结构化结果（不抛错） */
+export async function browseRoot(
+  sdk: RpcSdk,
+  input: { id: RootId; sub: string },
+): Promise<BrowseResult> {
+  const fallback = { ok: false, code: "call-failed", message: "", entries: [], count: 0, total: 0, truncated: false }
+
+  try {
+    const output = (await sdk.api.rpc.call({ rpcID: ROOTS_RPC_ID, method: "browse", input })).output
+    if (output === null || typeof output !== "object") return fallback
+    const result = output as Partial<BrowseResult>
+    const entries = Array.isArray(result.entries)
+      ? result.entries.flatMap((entry): BrowseEntry[] => {
+          if (entry === null || typeof entry !== "object") return []
+          const item = entry as Record<string, unknown>
+
+          if (typeof item.name !== "string") return []
+          return [{ name: item.name, type: item.type === "directory" ? "directory" : "file" }]
+        })
+      : []
+
+    return {
+      ok: result.ok === true,
+      code: typeof result.code === "string" ? result.code : "",
+      message: typeof result.message === "string" ? result.message : "",
+      entries,
+      count: typeof result.count === "number" ? result.count : entries.length,
+      total: typeof result.total === "number" ? result.total : entries.length,
+      truncated: result.truncated === true,
+    }
+  } catch (error) {
+    return { ...fallback, message: error instanceof Error ? error.message : String(error) }
+  }
+}
+
+/** 在主目录内新建文件夹；失败返回带 `code` 的结构化结果（不抛错） */
+export async function mkdirInRoot(
+  sdk: RpcSdk,
+  input: { id: RootId; parent: string; name: string },
+): Promise<MkdirResult> {
+  try {
+    const output = (await sdk.api.rpc.call({ rpcID: ROOTS_RPC_ID, method: "mkdir", input })).output
+    if (output !== null && typeof output === "object") {
+      const result = output as Partial<MkdirResult>
+
+      if (typeof result.ok === "boolean") {
+        return {
+          ok: result.ok,
+          code: typeof result.code === "string" ? result.code : "",
+          message: typeof result.message === "string" ? result.message : "",
+          path: typeof result.path === "string" ? result.path : "",
+        }
+      }
+    }
+  } catch (error) {
+    return { ok: false, code: "call-failed", message: error instanceof Error ? error.message : String(error), path: "" }
+  }
+  return { ok: false, code: "empty-output", message: "", path: "" }
+}
+
+/**
+ * 主动申请目录权限（点「请求权限」按钮时）。回调成功**不等于**真的可读，
+ * 是否生效必须以随后的一次真实列举为准（FR-203-025）。
+ */
+export async function requestDirectoryPermission(sdk: RpcSdk, id: RootId): Promise<PermissionResult> {
+  try {
+    const output = (await sdk.api.rpc.call({ rpcID: ROOTS_RPC_ID, method: "permissionRequest", input: { id } }))
+      .output
+    if (output !== null && typeof output === "object") {
+      const result = output as Partial<PermissionResult>
+
+      if (typeof result.granted === "boolean") {
+        return {
+          ok: result.ok === true,
+          code: typeof result.code === "string" ? result.code : "",
+          granted: result.granted,
+          bridgeUnavailable: result.bridgeUnavailable === true,
+          timeout: result.timeout === true,
+          message: typeof result.message === "string" ? result.message : "",
+        }
+      }
+    }
+  } catch (error) {
+    return {
+      ok: false,
+      code: "call-failed",
+      granted: false,
+      bridgeUnavailable: true,
+      timeout: false,
+      message: error instanceof Error ? error.message : String(error),
+    }
+  }
+  return { ok: false, code: "empty-output", granted: false, bridgeUnavailable: true, timeout: false, message: "" }
+}
