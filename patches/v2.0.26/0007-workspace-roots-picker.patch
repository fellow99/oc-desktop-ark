+import { describe, expect, test } from "bun:test"
+import { defaultFolderName, entryName, filterHiddenEntries, isWithin, normalizeRootPath, probeWorkspaceRoots, relativeFromRoot } from "./roots"
+
+describe("normalizeRootPath", () => {
+  test("removes trailing separators and unifies backslashes", () => {
+    expect(normalizeRootPath("/a/b/")).toBe("/a/b")
+    expect(normalizeRootPath("/a\\b/")).toBe("/a/b")
+    expect(normalizeRootPath("/")).toBe("/")
+  })
+})
+
+describe("isWithin", () => {
+  test("accepts the root itself and its descendants", () => {
+    expect(isWithin("/a/b", "/a/b")).toBe(true)
+    expect(isWithin("/a/b", "/a/b/c")).toBe(true)
+    expect(isWithin("/a/b/", "/a/b/c/")).toBe(true)
+  })
+
+  test("rejects a sibling that shares a name prefix", () => {
+    expect(isWithin("/a/b", "/a/bc")).toBe(false)
+    expect(isWithin("/a/b", "/a/bc/d")).toBe(false)
+  })
+
+  test("rejects escapes and traversal segments", () => {
+    expect(isWithin("/a/b", "/a")).toBe(false)
+    expect(isWithin("/a/b", "..")).toBe(false)
+    expect(isWithin("/a/b", "/a/b/../c")).toBe(false)
+    expect(isWithin("", "/a")).toBe(false)
+  })
+
+  test("handles a filesystem root as the fence", () => {
+    expect(isWithin("/", "/a")).toBe(true)
+    expect(isWithin("/", "/")).toBe(true)
+  })
+})
+
+describe("relativeFromRoot", () => {
+  test("returns an empty string for the root itself", () => {
+    expect(relativeFromRoot("/a/b", "/a/b")).toBe("")
+    expect(relativeFromRoot("/a/b", "/a/b/")).toBe("")
+  })
+
+  test("returns the sub path without a leading separator", () => {
+    expect(relativeFromRoot("/a/b", "/a/b/c/d")).toBe("c/d")
+  })
+
+  test("returns undefined outside the root", () => {
+    expect(relativeFromRoot("/a/b", "/a/bc")).toBeUndefined()
+    expect(relativeFromRoot("/a/b", "/a")).toBeUndefined()
+  })
+})
+
+describe("defaultFolderName", () => {
+  test("keeps the base name when free and appends a counter when taken", () => {
+    expect(defaultFolderName([], "未命名文件夹")).toBe("未命名文件夹")
+    expect(defaultFolderName(["未命名文件夹"], "未命名文件夹")).toBe("未命名文件夹 2")
+    expect(defaultFolderName(["未命名文件夹", "未命名文件夹 2"], "未命名文件夹")).toBe("未命名文件夹 3")
+    expect(defaultFolderName(["other"], "未命名文件夹")).toBe("未命名文件夹")
+  })
+})
+
+describe("filterHiddenEntries and entryName", () => {
+  test("drops dot-prefixed last segments only", () => {
+    expect(filterHiddenEntries([".git", "src", ".config/x", "a/.b", "a/b"])).toEqual(["src", ".config/x", "a/b"])
+  })
+
+  test("entryName returns the last segment", () => {
+    expect(entryName("a/b/")).toBe("b")
+    expect(entryName("a")).toBe("a")
+    expect(entryName("")).toBe("")
+  })
+})
+
+describe("probeWorkspaceRoots", () => {
+  test("returns undefined when the RPC is unavailable (self-gating)", async () => {
+    const sdk = {
+      api: {
+        rpc: {
+          call: () => Promise.reject(new Error("not registered")),
+        },
+      },
+    }
+
+    expect(await probeWorkspaceRoots(sdk)).toBeUndefined()
+  })
+
+  test("returns undefined when the payload shape does not match", async () => {
+    const sdk = { api: { rpc: { call: async () => ({ output: { roots: [] } }) } } }
+
+    expect(await probeWorkspaceRoots(sdk)).toBeUndefined()
+  })
+
+  test("maps a valid payload and drops unknown root ids", async () => {
+    const sdk = {
+      api: {
+        rpc: {
+          call: async () => ({
+            output: {
+              home: "/h",
+              userHome: "/u",
+              roots: [
+                { id: "sandbox", path: "/h/workspace", available: true, needsPermission: false, reason: "" },
+                { id: "documents", path: "/u/Documents", available: false, needsPermission: true, reason: "EPERM" },
+                { id: "desktop", path: "/u/Desktop", available: true },
+              ],
+            },
+          }),
+        },
+      },
+    }
+    const set = await probeWorkspaceRoots(sdk)
+
+    expect(set?.roots.map((entry) => entry.id)).toEqual(["sandbox", "documents"])
+    expect(set?.roots[1]?.reason).toBe("EPERM")
+  })
+})
