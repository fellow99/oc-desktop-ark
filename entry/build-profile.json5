{
  "apiType": "stageMode",
  "buildOption": {
    // 本模块**不编译 C++**：引导件（libnode_bridge.so）随 @fellow99/node-bridge（ohpm 包）提供；
    // Node 引擎（libnode.so）与 libc++_shared.so 随 @fellow99/node-runtime（ohpm 包）合并进 HAP。
    // ⚠️ entry/libs/arm64-v8a/ 不得手工放同名 .so（与运行时包两种来源择一）；
    // module 级 nativeLib 不接受 abiFilters（它只吃 debugSymbol / filter / headerPath /
    // collectAllLibs / librariesInfo 等键，写错会 schema 报错）。
    "nativeLib": {
      "collectAllLibs": true
    }
  },
  "targets": [
    {
      "name": "default"
    }
  ]
}
